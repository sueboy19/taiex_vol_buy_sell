# 複製為 .env（本機開發）；正式環境在 Coolify 的 Environment 變數 UI 設定同名變數

# FinMind API token（選填，提升資料回填額度）
FINMIND_TOKEN=

# 允許跨源來源（逗號分隔、含 scheme）；正式環境由 Coolify 自動帶入 frontend 網域
# 例：CORS_ORIGINS=https://taiex.mkinweb.com
CORS_ORIGINS=*

# WebSocket 連線數上限（防資源耗盡）
WS_MAX_CONNECTIONS=200

# DuckDB 檔案路徑（容器內）
DUCKDB_PATH=/data/taiex.duckdb
